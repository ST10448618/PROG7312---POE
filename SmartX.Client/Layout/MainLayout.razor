@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-950 text-slate-100">
    <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-10">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="font-semibold tracking-tight text-slate-100">Smart-X Telemetry</span>
                <span class="relative flex h-2 w-2 ml-1">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
            </div>

            <nav class="flex gap-1">
                <NavLink href="" Match="NavLinkMatch.All" class="nav-tab">Home</NavLink>
                <NavLink href="dashboard" class="nav-tab">Overview</NavLink>
                <NavLink href="anomalies" class="nav-tab">Anomaly Logs</NavLink>
                <NavLink href="ingestion" class="nav-tab">Data Ingestion</NavLink>
                <NavLink href="integrations" class="nav-tab">Integration</NavLink>
                <NavLink href="health" class="nav-tab">System Health</NavLink>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-8">
        @Body
    </main>
</div>