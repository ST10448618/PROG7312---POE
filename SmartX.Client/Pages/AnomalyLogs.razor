@page "/anomalies"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SensorApiClient Api

<div class="page-header">
    <h1>Anomaly Logs</h1>
</div>

<div style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
    <input @bind="_search" @bind:event="oninput" placeholder="Search sensor ID…"
           style="flex: 1; background: var(--panel); border: 1px solid var(--line); color: var(--text); padding: 0.55rem; border-radius: 6px;" />
    <select @bind="_severity">
        <option value="All">All severities</option>
        <option value="Critical">Critical</option>
        <option value="Warning">Warning</option>
        <option value="Disconnected">Disconnected</option>
        <option value="Normal">Normal</option>
    </select>
    <button class="btn-secondary" @onclick="Load">Filter</button>
</div>

<div class="card">
    @if (_loadError is not null)
    {
        <div class="alert-banner">@_loadError</div>
    }
    <table class="data-table">
        <thead>
            <tr><th>Timestamp</th><th>Sensor ID</th><th>Severity</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (_logs is not null)
            {
                @foreach (var log in _logs)
                {
                    <tr>
                        <td style="color: var(--text-dim);">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td class="mono">@log.SensorId</td>
                        <td><span class="badge @SeverityBadge(log.Severity)">@log.Severity</span></td>
                        <td>
                            <span style="display: flex; align-items: center; gap: 0.4rem;">
                                @if (!log.Acknowledged)
                                {
                                    <span class="pulse-dot amber"><span class="ping pulse-slow"></span><span class="core"></span></span>
                                }
                                @(log.Acknowledged ? "Acknowledged" : "Unresolved")
                            </span>
                        </td>
                        <td>
                            @if (!log.Acknowledged)
                            {
                                <button class="btn-secondary btn-sm" @onclick="() => Acknowledge(log.Id)">Acknowledge</button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (_logs is not null && _logs.Count == 0)
    {
        <p class="empty-state" style="margin-top: 1rem;">No anomalies match this filter.</p>
    }
</div>

@code {
    private List<AnomalyLogDto>? _logs;
    private string _search = "";
    private string _severity = "All";
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { _logs = await Api.GetAnomalyLogsAsync(_severity, _search); }
        catch (Exception ex) { _loadError = "Couldn't load anomaly logs."; Console.Error.WriteLine(ex); }
    }

    private async Task Acknowledge(int id)
    {
        await Api.AcknowledgeAnomalyAsync(id);
        await Load();
    }

    private static string SeverityBadge(string severity) => severity switch
    {
        "Critical" => "badge-rose",
        "Warning" => "badge-amber",
        "Disconnected" => "badge-info",
        _ => "badge-emerald"
    };
}