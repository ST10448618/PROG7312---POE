@page "/ingestion"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IAsyncDisposable
@inject SensorApiClient Api
@inject ApiConfig Config

<div class="page-header">
    <h1>Data Ingestion</h1>
    <p class="page-subtitle">ESP32 Sensors → .NET API → Ingestion Gateway → Anomaly Engine</p>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

<div class="pipeline-grid">
    <div class="pipeline-stage">
        <p>ESP32 Sensors</p>
        <p class="pipeline-metric">@(_summary?.TotalSensors ?? 0)</p>
        <span class="badge badge-emerald">Healthy</span>
    </div>
    <div class="pipeline-stage">
        <p>.NET API Layer</p>
        <p class="pipeline-metric">@(_health?.DbConnected == true ? "Online" : "Degraded")</p>
        <span class="badge @(_health?.DbConnected == true ? "badge-emerald" : "badge-rose")">@(_health?.DbConnected == true ? "Healthy" : "Error")</span>
    </div>
    <div class="pipeline-stage">
        <p>Ingestion Gateway</p>
        <p class="pipeline-metric">@(_summary?.TotalTelemetryLogs ?? 0) events</p>
        <span class="badge badge-emerald">Healthy</span>
    </div>
    <div class="pipeline-stage">
        <p>Anomaly Engine</p>
        <p class="pipeline-metric">@(_health?.CriticalAnomaliesLast24h ?? 0) alerts/24h</p>
        <span class="badge badge-emerald">Running</span>
    </div>
</div>

<div class="three-col">
    <section class="card">
        <h3 style="margin-bottom: 1rem;">Register a sensor</h3>
        <EditForm Model="_newSensor" OnValidSubmit="RegisterSensor">
            <div class="form-field">
                <label>MAC Address</label>
                <InputText @bind-Value="_newSensor.MacAddress" placeholder="AA:BB:CC:00:11:22" />
            </div>
            <div class="form-field">
                <label>Deployment Location</label>
                <InputText @bind-Value="_newSensor.Location" placeholder="Facility A/Zone 1/Sub-Zone B/Rack 1" />
            </div>
            <div class="form-field">
                <label>Category</label>
                <InputSelect @bind-Value="_newSensor.Category">
                    <option value="">Select…</option>
                    <option value="Environmental">Environmental</option>
                    <option value="Power Consumption">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </InputSelect>
            </div>
            <button type="submit" class="btn-primary" style="width: 100%;">Register sensor</button>
        </EditForm>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <p class="status-message @(_statusOk ? "ok" : "error")">@_statusMessage</p>
        }

        <hr style="border: none; border-top: 1px solid var(--line); margin: 1.25rem 0;" />

        <h3 style="margin-bottom: 0.5rem;">Deployment path validator</h3>
        <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.75rem;">Recursively validates a facility hierarchy path.</p>
        <div style="display: flex; gap: 0.5rem;">
            <input @bind="_pathToValidate" placeholder="Facility A/Zone 1/Sub-Zone B/Rack 1"
                   style="flex: 1; background: var(--bg); border: 1px solid var(--line); color: var(--text); padding: 0.5rem; border-radius: 6px;" />
            <button class="btn-secondary" @onclick="ValidatePath">Validate</button>
        </div>
        @if (_pathResult is not null)
        {
            <p class="status-message @(_pathResult == true ? "ok" : "error")">
                @(_pathResult == true ? "Path is valid." : "Path could not be resolved.")
            </p>
        }
    </section>

    <section class="card">
        <h3 style="margin-bottom: 1rem;">Registered sensors</h3>
        @if (_sensors.Count == 0)
        {
            <p class="empty-state">No sensors registered yet.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th>MAC</th><th>Location</th><th>Status</th><th>Attach</th><th>Simulate</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _sensors)
                    {
                        <tr>
                            <td class="mono">@s.MacAddress</td>
                            <td style="color: var(--text-dim);">@s.Location</td>
                            <td><span class="badge badge-emerald">@s.Status</span></td>
                            <td><InputFile OnChange="e => UploadFile(e, s.MacAddress)" style="font-size: 0.78rem;" /></td>
                            <td>
                                <button class="btn-secondary btn-sm" @onclick="() => SimulateReading(s.MacAddress)">Normal</button>
                                <button class="btn-secondary btn-sm" @onclick="() => SimulateSpike(s.MacAddress)">Spike</button>
                                <button class="btn-secondary btn-sm" @onclick="() => SimulateDrop(s.MacAddress)">Drop</button>
                                <button class="btn-secondary btn-sm" @onclick="() => SimulateDisconnect(s.MacAddress)">Disconnect</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

<div class="card" style="margin-top: 1.5rem;">
    <div class="title-with-dot" style="margin-bottom: 1rem;">
        <h3>Live Events Stream</h3>
        <span class="pulse-dot"><span class="ping pulse-slow"></span><span class="core"></span></span>
    </div>
    <div class="event-stream">
        @if (_liveEvents.Count == 0)
        {
            <span class="empty-state">Waiting for telemetry…</span>
        }
        @foreach (var evt in _liveEvents)
        {
            <div>@evt</div>
        }
    </div>
</div>

@code {
    private SensorDto _newSensor = new();
    private List<SensorDto> _sensors = new();
    private SensorSummaryDto? _summary;
    private SystemHealthDto? _health;
    private string _statusMessage = "";
    private bool _statusOk;
    private string _pathToValidate = "";
    private bool? _pathResult;
    private readonly Random _rnd = new();
    private readonly List<string> _liveEvents = new();
    private HubConnection? _hub;
    private string? _loadError;
    private async Task SimulateSpike(string mac) { await Api.PushExtremeAsync(mac, 900f); await RefreshAll(); }
    private async Task SimulateDrop(string mac) { await Api.PushExtremeAsync(mac, -900f); await RefreshAll(); }
    private async Task SimulateDisconnect(string mac) { await Api.MarkDisconnectedAsync(mac); await RefreshAll(); }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshAll();
           _hub = new HubConnectionBuilder()
            .WithUrl($"{Config.BaseUrl}/hubs/telemetry")
            .WithAutomaticReconnect()
            .Build();
            _hub.On<object>("TelemetryIngested", async evt =>
            {
                _liveEvents.Insert(0, evt.ToString() ?? "");
                if (_liveEvents.Count > 15) _liveEvents.RemoveAt(_liveEvents.Count - 1);
                await InvokeAsync(StateHasChanged);
            });
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Couldn't reach the API or live telemetry hub.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task RefreshAll()
    {
        _sensors = await Api.GetSensorsAsync() ?? new();
        _summary = await Api.GetSummaryAsync();
        _health = await Api.GetHealthSummaryAsync();
    }

    private async Task RegisterSensor()
    {
        var response = await Api.RegisterAsync(_newSensor);
        _statusOk = response.IsSuccessStatusCode;
        _statusMessage = _statusOk ? $"Registered {_newSensor.MacAddress}." : await response.Content.ReadAsStringAsync();
        if (_statusOk) _newSensor = new();
        await RefreshAll();
    }

    private async Task UploadFile(InputFileChangeEventArgs e, string mac)
    {
        var file = e.File;
        using var content = new MultipartFormDataContent();
        content.Add(new StreamContent(file.OpenReadStream(10 * 1024 * 1024)), "file", file.Name);
        await Api.UploadFileAsync(mac, content);
    }

    private async Task SimulateReading(string mac)
    {
        var value = (float)Math.Round(_rnd.NextDouble() * 100, 2);
        await Api.PushMoistureAsync(mac, value);
        await RefreshAll();
    }

    private async Task ValidatePath()
    {
        var result = await Api.ValidatePathAsync(_pathToValidate);
        var body = await result.Content.ReadFromJsonAsync<ValidationResult>();
        _pathResult = body?.isValid;
    }

    private record ValidationResult(string path, bool isValid);

    public async ValueTask DisposeAsync() { if (_hub is not null) await _hub.DisposeAsync(); }
}