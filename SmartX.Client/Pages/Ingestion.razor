@page "/ingestion"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IAsyncDisposable
@inject SensorApiClient Api
@inject NavigationManager Nav

<h1 class="text-xl font-semibold mb-1">Data Ingestion</h1>
<p class="text-sm text-slate-400 mb-6">ESP32 sensors → .NET API → Ingestion Gateway → Anomaly Engine</p>

<div class="grid grid-cols-4 gap-4 mb-8">
    <div class="card text-center">
        <p class="text-xs text-slate-400 mb-2">ESP32 Sensors</p>
        <p class="text-lg font-semibold">@(_summary?.TotalSensors ?? 0)</p>
        <span class="badge-emerald mt-2 inline-block">Healthy</span>
    </div>
    <div class="card text-center">
        <p class="text-xs text-slate-400 mb-2">.NET API Layer</p>
        <p class="text-lg font-semibold">@(_health?.DbConnected == true ? "Online" : "Degraded")</p>
        <span class="@(_health?.DbConnected == true ? "badge-emerald" : "badge-rose") mt-2 inline-block">@(_health?.DbConnected == true ? "Healthy" : "Error")</span>
    </div>
    <div class="card text-center">
        <p class="text-xs text-slate-400 mb-2">Ingestion Gateway</p>
        <p class="text-lg font-semibold">@(_summary?.TotalTelemetryLogs ?? 0) events</p>
        <span class="badge-emerald mt-2 inline-block">Healthy</span>
    </div>
    <div class="card text-center">
        <p class="text-xs text-slate-400 mb-2">Anomaly Engine</p>
        <p class="text-lg font-semibold">@(_health?.CriticalAnomaliesLast24h ?? 0) alerts/24h</p>
        <span class="badge-emerald mt-2 inline-block">Running</span>
    </div>
</div>

<div class="grid grid-cols-3 gap-6">
    <section class="card col-span-1">
        <h3 class="font-medium mb-4">Register a sensor</h3>
        <EditForm Model="_newSensor" OnValidSubmit="RegisterSensor" class="flex flex-col gap-3">
            <label class="text-sm">MAC Address
                <InputText @bind-Value="_newSensor.MacAddress" class="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-1.5 mt-1" />
            </label>
            <label class="text-sm">Deployment Location
                <InputText @bind-Value="_newSensor.Location" class="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-1.5 mt-1" />
            </label>
            <label class="text-sm">Category
                <InputSelect @bind-Value="_newSensor.Category" class="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-1.5 mt-1">
                    <option value="">Select…</option>
                    <option value="Environmental">Environmental</option>
                    <option value="Power Consumption">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </InputSelect>
            </label>
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white rounded-md py-2 text-sm font-medium">Register sensor</button>
        </EditForm>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <p class="text-xs mt-3 @(_statusOk ? "text-emerald-400" : "text-rose-400")">@_statusMessage</p>
        }
    </section>

    <section class="card col-span-2">
        <h3 class="font-medium mb-4">Registered sensors</h3>
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-800">
                    <th class="pb-2">MAC</th><th class="pb-2">Location</th><th class="pb-2">Status</th><th class="pb-2">Attach</th><th class="pb-2">Simulate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sensors)
                {
                    <tr class="border-b border-slate-900">
                        <td class="py-2 font-mono">@s.MacAddress</td>
                        <td class="py-2 text-slate-400">@s.Location</td>
                        <td class="py-2"><span class="badge-emerald">@s.Status</span></td>
                        <td class="py-2"><InputFile OnChange="e => UploadFile(e, s.MacAddress)" class="text-xs" /></td>
                        <td class="py-2">
                            <button class="nav-tab bg-slate-800" @onclick="() => SimulateReading(s.MacAddress)">Send</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

<div class="card mt-6">
    <div class="flex items-center gap-2 mb-4">
        <h3 class="font-medium">Live Events Stream</h3>
        <span class="relative flex h-1.5 w-1.5">
            <span class="animate-pulse-slow absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
        </span>
    </div>
    <div class="flex flex-col gap-1 max-h-48 overflow-y-auto font-mono text-xs text-slate-400">
        @foreach (var evt in _liveEvents)
        {
            <div class="animate-in fade-in duration-300">@evt</div>
        }
    </div>
</div>

@code {
    private SensorDto _newSensor = new();
    private List<SensorDto> _sensors = new();
    private SensorSummaryDto? _summary;
    private SystemHealthDto? _health;
    private string _statusMessage = "";
    private bool _statusOk;
    private readonly Random _rnd = new();
    private readonly List<string> _liveEvents = new();
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
        _hub = new HubConnectionBuilder().WithUrl(Nav.ToAbsoluteUri("/hubs/telemetry")).WithAutomaticReconnect().Build();
        _hub.On<object>("TelemetryIngested", async evt =>
        {
            _liveEvents.Insert(0, evt.ToString() ?? "");
            if (_liveEvents.Count > 15) _liveEvents.RemoveAt(_liveEvents.Count - 1);
            await InvokeAsync(StateHasChanged);
        });
        await _hub.StartAsync();
    }

    private async Task RefreshAll()
    {
        _sensors = await Api.GetSensorsAsync() ?? new();
        _summary = await Api.GetSummaryAsync();
        _health = await Api.GetHealthSummaryAsync();
    }

    private async Task RegisterSensor()
    {
        var response = await Api.RegisterAsync(_newSensor);
        _statusOk = response.IsSuccessStatusCode;
        _statusMessage = _statusOk ? $"Registered {_newSensor.MacAddress}." : await response.Content.ReadAsStringAsync();
        if (_statusOk) _newSensor = new();
        await RefreshAll();
    }

    private async Task UploadFile(InputFileChangeEventArgs e, string mac)
    {
        var file = e.File;
        using var content = new MultipartFormDataContent();
        content.Add(new StreamContent(file.OpenReadStream(10 * 1024 * 1024)), "file", file.Name);
        await Api.UploadFileAsync(mac, content);
    }

    private async Task SimulateReading(string mac)
    {
        var value = (float)Math.Round(_rnd.NextDouble() * 100, 2);
        await Api.PushMoistureAsync(mac, value);
        await RefreshAll();
    }

    public async ValueTask DisposeAsync() { if (_hub is not null) await _hub.DisposeAsync(); }
}