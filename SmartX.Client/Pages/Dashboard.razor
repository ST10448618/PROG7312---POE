@page "/dashboard"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartX.Client.Models
@using SmartX.Client.Services
@using System.Linq
@implements IAsyncDisposable
@inject SensorApiClient Api
@inject ApiConfig Config

<div class="card-header">
    <div>
        <div class="title-with-dot">
            <h1>Telemetry Overview</h1>
            <span class="pulse-dot"><span class="ping"></span><span class="core"></span></span>
        </div>
        <p class="page-subtitle">@DateTime.Now.ToString("HH:mm:ss") · live monitoring</p>
    </div>
    <button class="btn-secondary" @onclick="RefreshSummary">Refresh</button>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

@if (_summary is not null)
{
    <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card"><p class="stat-label">Total Nodes</p><p class="stat-value">@_summary.TotalSensors</p></div>
        <div class="stat-card"><p class="stat-label">Active Alerts</p><p class="stat-value rose">@_activeCritical.Count</p></div>
        <div class="stat-card"><p class="stat-label">Online</p><p class="stat-value emerald">@_summary.OnlineSensors</p></div>
    </div>
}

<div class="card" style="margin-bottom: 1.5rem;">
    <div class="legend">
        <span class="legend-item"><i class="swatch emerald"></i>Normal</span>
        <span class="legend-item"><i class="swatch amber"></i>Warning</span>
        <span class="legend-item"><i class="swatch rose"></i>Critical</span>
        <span class="legend-item"><i class="swatch info"></i>Disconnected</span>
    </div>

    @if (_rows.Count == 0)
    {
        <p class="empty-state">No telemetry yet — push a reading from Data Ingestion to see live scoring.</p>
    }
    else
    {
        @foreach (var sensorId in _rows)
        {
            <div class="heatmap-row">
                <span class="row-label">@sensorId</span>
                <span class="badge @CategoryBadge(CategoryFor(sensorId))" style="margin-right: 0.5rem;">@CategoryFor(sensorId)</span>
                <div class="cell-track">
                    @foreach (var cell in _cellsBySensor[sensorId])
                    {
                        <div class="heat-cell @CellColour(cell.Colour)" @onclick="() => SelectSensor(sensorId)"
                            title="@($"{cell.Value:0.0} (score {cell.Score:0.00})")"></div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (_activeCritical.Count > 0)
{
    @foreach (var alert in _activeCritical)
    {
        <div class="alert-banner">
            <span class="pulse-dot rose"><span class="ping pulse-slow"></span><span class="core"></span></span>
            Critical anomaly on <span class="mono">&nbsp;@alert.SensorId&nbsp;</span> — score @alert.Score.ToString("0.00")
        </div>
    }
}

@if (_selectedSensor is not null)
{
    <div class="slideout">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3>@_selectedSensor</h3>
            <button class="slideout-close" @onclick="() => _selectedSensor = null">✕</button>
        </div>
        <p style="font-size: 0.78rem; color: var(--text-dim); margin-bottom: 0.5rem;">Historical Context</p>
        @if (_history is not null)
        {
            <div class="mono" style="font-size: 0.78rem; max-height: 16rem; overflow-y: auto;">
                @foreach (var row in _history)
                {
                    <div>@row[0].ToString("0.0")</div>
                }
            </div>
        }

        <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1.5rem;">
            <button class="btn-secondary" @onclick='() => _panelView = "telemetry"'>View Real-Time Telemetry</button>
            <button class="btn-secondary" @onclick='() => _panelView = "network"'>View Network Context</button>
            <button class="btn-secondary" @onclick='() => _panelView = "actions"'>Recommended Actions</button>
        </div>

        @if (_panelView == "telemetry" && _cellsBySensor.TryGetValue(_selectedSensor, out var liveCells) && liveCells.Count > 0)
        {
            var latest = liveCells[^1];
            <div class="card" style="margin-top: 1rem;">
                <p class="stat-label">Latest reading</p>
                <p class="stat-value">@latest.Value.ToString("0.0")</p>
                <p style="font-size: 0.8rem; color: var(--text-dim);">
                    score @latest.Score.ToString("0.00") · @latest.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                </p>
            </div>
        }
        else if (_panelView == "telemetry")
        {
            <p class="empty-state" style="margin-top: 1rem;">No live readings yet for this sensor.</p>
        }

        @if (_panelView == "network")
        {
            var sensor = _sensors.FirstOrDefault(s => s.MacAddress == _selectedSensor);
            <div class="card" style="margin-top: 1rem;">
                <p class="stat-label">Deployment path</p>
                <p style="font-size: 0.9rem;">@(sensor?.Location ?? "Unknown")</p>
                <p style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.4rem;">
                    Category: @(sensor?.Category ?? "Unknown")
                </p>
            </div>
        }

        @if (_panelView == "actions")
        {
            var hasCritical = _activeCritical.Any(a => a.SensorId == _selectedSensor);
            <div class="card" style="margin-top: 1rem;">
                <p style="font-size: 0.9rem;">
                    @(hasCritical
                        ? "⚠ Investigate immediately — recent reading is a statistical outlier."
                        : "✓ No action needed — readings are within normal range.")
                </p>
            </div>
        }
    </div>
}

@code {
    private HubConnection? _hub;
    private readonly List<string> _rows = new();
    private readonly Dictionary<string, List<AnomalyCellDto>> _cellsBySensor = new();
    private readonly List<AnomalyCellDto> _activeCritical = new();
    private List<SensorDto> _sensors = new();
    private SensorSummaryDto? _summary;
    private string? _selectedSensor;
    private string? _panelView;
    private double[][]? _history;
    private string? _loadError;
    private const int MaxCellsPerRow = 30;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshSummary();
            _sensors = await Api.GetSensorsAsync() ?? new();
            await LoadRecentHistory();

            _hub = new HubConnectionBuilder().WithUrl($"{Config.BaseUrl}/hubs/telemetry").WithAutomaticReconnect().Build();
            _hub.On<AnomalyCellDto>("AnomalyUpdate", async cell =>
            {
                try
                {
                    if (!_cellsBySensor.ContainsKey(cell.SensorId)) { _cellsBySensor[cell.SensorId] = new(); _rows.Add(cell.SensorId); }
                    var row = _cellsBySensor[cell.SensorId];
                    row.Add(cell);
                    if (row.Count > MaxCellsPerRow) row.RemoveAt(0);

                    if (cell.Colour == "Red")
                    {
                        _activeCritical.RemoveAll(a => a.SensorId == cell.SensorId);
                        _activeCritical.Insert(0, cell);
                    }
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"AnomalyUpdate handler failed: {ex}");
                }
            });
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Couldn't reach the API or live telemetry hub.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task LoadRecentHistory()
    {
        var logs = await Api.GetAnomalyLogsAsync("All", "");
        if (logs is null) return;

        foreach (var log in logs.OrderBy(l => l.Timestamp))
        {
            var cell = new AnomalyCellDto
            {
                SensorId = log.SensorId,
                Value = log.Value,
                Score = log.Score,
                Colour = log.Colour,
                Timestamp = log.Timestamp
            };

            if (!_cellsBySensor.ContainsKey(cell.SensorId)) { _cellsBySensor[cell.SensorId] = new(); _rows.Add(cell.SensorId); }
            var row = _cellsBySensor[cell.SensorId];
            row.Add(cell);
            if (row.Count > MaxCellsPerRow) row.RemoveAt(0);

            if (cell.Colour == "Red")
            {
                _activeCritical.RemoveAll(a => a.SensorId == cell.SensorId);
                _activeCritical.Insert(0, cell);
            }
        }
    }

    private async Task RefreshSummary() => _summary = await Api.GetSummaryAsync();

    private async Task SelectSensor(string sensorId)
    {
        _selectedSensor = sensorId;
        _panelView = null;
        _history = await Api.GetSensorHistoryAsync(sensorId);
    }

    private static string CellColour(string colour) => colour.ToLowerInvariant() switch
    {
        "red" => "rose",
        "amber" => "amber",
        "blue" => "info",
        _ => "emerald"
    };

    private string CategoryFor(string mac) =>
        _sensors.FirstOrDefault(s => s.MacAddress == mac)?.Category ?? "Unknown";

    private static string CategoryBadge(string category) => category switch
    {
        "Environmental" => "badge-info",
        "Power Consumption" => "badge-amber",
        "Actuator" => "badge-emerald",
        _ => "badge-slate"
    };
    public async ValueTask DisposeAsync()
{
    try { if (_hub is not null) await _hub.DisposeAsync(); }
    catch { /* connection may never have fully established; safe to ignore on teardown */ }
}
}