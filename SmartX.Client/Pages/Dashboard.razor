@page "/dashboard"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject SensorApiClient Api

<div class="flex items-center justify-between mb-6">
    <div>
        <div class="flex items-center gap-2">
            <h1 class="text-xl font-semibold">Telemetry Overview</h1>
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
        </div>
        <p class="text-sm text-slate-400 mt-1">@DateTime.Now.ToString("HH:mm:ss") · live monitoring</p>
    </div>
    <div class="flex gap-2">
        <select class="bg-slate-900 border border-slate-800 rounded-md px-3 py-1.5 text-sm">
            <option>Last 30 readings</option>
            <option>Last 60 readings</option>
        </select>
        <button class="nav-tab bg-slate-900" @onclick="RefreshSummary">Refresh</button>
    </div>
</div>

@if (_summary is not null)
{
    <div class="grid grid-cols-3 gap-6 mb-6">
        <div class="card"><p class="text-sm text-slate-400">Total Nodes</p><p class="text-2xl font-semibold mt-1">@_summary.TotalSensors</p></div>
        <div class="card"><p class="text-sm text-slate-400">Active Alerts</p><p class="text-2xl font-semibold mt-1 text-rose-400">@_redCount</p></div>
        <div class="card"><p class="text-sm text-slate-400">Online</p><p class="text-2xl font-semibold mt-1 text-emerald-400">@_summary.OnlineSensors</p></div>
    </div>
}

<div class="card mb-6">
    <div class="flex items-center gap-4 text-xs text-slate-400 mb-4">
        <span class="flex items-center gap-1.5"><i class="w-2.5 h-2.5 rounded bg-emerald-600/40"></i>Normal</span>
        <span class="flex items-center gap-1.5"><i class="w-2.5 h-2.5 rounded bg-rose-600/40"></i>Critical</span>
        <span class="flex items-center gap-1.5"><i class="w-2.5 h-2.5 rounded bg-amber-600/40"></i>Warning</span>
        <span class="flex items-center gap-1.5"><i class="w-2.5 h-2.5 rounded bg-slate-700/60"></i>Disconnected</span>
    </div>

    @if (_rows.Count == 0)
    {
        <p class="text-sm text-slate-400">No telemetry yet — push a reading from Data Ingestion to see live scoring.</p>
    }
    else
    {
        <div class="flex flex-col gap-1.5">
            @foreach (var sensorId in _rows)
            {
                <div class="flex items-center gap-3">
                    <span class="font-mono text-xs text-slate-400 w-40 truncate">@sensorId</span>
                    <div class="flex gap-1">
                        @foreach (var cell in _cellsBySensor[sensorId])
                        {
                            <div class="@CellClasses(cell.Colour)" @onclick="() => SelectSensor(sensorId)" title="@($"{cell.Value:0.0} (score {cell.Score:0.00})")"></div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_activeCritical.Count > 0)
{
    <div class="flex flex-col gap-2 mb-6">
        @foreach (var alert in _activeCritical)
        {
            <div class="flex items-center gap-3 bg-rose-950/40 border-l-2 border-rose-500 rounded-r-md px-4 py-3">
                <span class="relative flex h-2 w-2">
                    <span class="animate-pulse-slow absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-60"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                </span>
                <span class="text-sm text-rose-300">Critical anomaly on <span class="font-mono">@alert.SensorId</span> — score @alert.Score.ToString("0.00")</span>
            </div>
        }
    </div>
}

@if (_selectedSensor is not null)
{
    <div class="fixed inset-y-0 right-0 w-96 bg-slate-900 border-l border-slate-800 p-6 overflow-y-auto shadow-xl">
        <div class="flex justify-between items-center mb-4">
            <h3 class="font-medium">@_selectedSensor</h3>
            <button class="text-slate-400 hover:text-slate-100" @onclick="() => _selectedSensor = null">✕</button>
        </div>
        <p class="text-xs text-slate-400 mb-2">Historical Context</p>
        @if (_history is not null)
        {
            <div class="flex flex-col gap-1 text-xs font-mono text-slate-300 max-h-64 overflow-y-auto">
                @foreach (var row in _history)
                {
                    <div>@row[0].ToString("0.0")</div>
                }
            </div>
        }
        <div class="mt-6 flex flex-col gap-2">
            <button class="nav-tab bg-slate-800 text-left">View Real-Time Telemetry</button>
            <button class="nav-tab bg-slate-800 text-left">View Network Context</button>
            <button class="nav-tab bg-slate-800 text-left">Recommended Actions</button>
        </div>
    </div>
}

@code {
    private HubConnection? _hub;
    private readonly List<string> _rows = new();
    private readonly Dictionary<string, List<AnomalyCellDto>> _cellsBySensor = new();
    private readonly List<AnomalyCellDto> _activeCritical = new();
    private SensorSummaryDto? _summary;
    private string? _selectedSensor;
    private double[][]? _history;
    private int _redCount => _activeCritical.Count;
    private const int MaxCellsPerRow = 30;

    protected override async Task OnInitializedAsync()
    {
        await RefreshSummary();

        _hub = new HubConnectionBuilder().WithUrl(Nav.ToAbsoluteUri("/hubs/telemetry")).WithAutomaticReconnect().Build();
        _hub.On<AnomalyCellDto>("AnomalyUpdate", async cell =>
        {
            if (!_cellsBySensor.ContainsKey(cell.SensorId)) { _cellsBySensor[cell.SensorId] = new(); _rows.Add(cell.SensorId); }
            var row = _cellsBySensor[cell.SensorId];
            row.Add(cell);
            if (row.Count > MaxCellsPerRow) row.RemoveAt(0);

            if (cell.Colour == "Red") _activeCritical.RemoveAll(a => a.SensorId == cell.SensorId);
            if (cell.Colour == "Red") _activeCritical.Insert(0, cell);

            await InvokeAsync(StateHasChanged);
        });
        await _hub.StartAsync();
    }

    private async Task RefreshSummary() => _summary = await Api.GetSummaryAsync();

    private async Task SelectSensor(string sensorId)
    {
        _selectedSensor = sensorId;
        _history = await Api.GetSensorHistoryAsync(sensorId);
    }

    private static string CellClasses(string colour)
    {
        var baseClasses = "w-3.5 h-3.5 rounded-sm cursor-pointer hover:scale-[1.15] transition-all duration-200";
        return colour.ToLower() switch
        {
            "red" => $"{baseClasses} bg-rose-600/60 animate-pulse-slow",
            "green" => $"{baseClasses} bg-emerald-600/50",
            "blue" => $"{baseClasses} bg-amber-600/50",
            _ => $"{baseClasses} bg-slate-700/50"
        };
    }

    public async ValueTask DisposeAsync() { if (_hub is not null) await _hub.DisposeAsync(); }
}