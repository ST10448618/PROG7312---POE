@page "/health"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SensorApiClient Api

<div class="title-with-dot page-header">
    <h1>System Health</h1>
    <span class="pulse-dot"><span class="ping"></span><span class="core"></span></span>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

@if (_health is not null)
{
    <div class="stat-grid" style="grid-template-columns: repeat(2, 1fr);">
        <div class="card">
            <p class="stat-label">@_health.TotalSensors+ Nodes</p>
            <div class="progress-track" style="margin: 0.5rem 0;">
                <div class="progress-fill" style="width: @(_health.TotalSensors == 0 ? 0 : (_health.OnlineSensors * 100 / _health.TotalSensors))%"></div>
            </div>
            <p style="font-size: 0.75rem; color: var(--text-faint);">@_health.OnlineSensors of @_health.TotalSensors online</p>
        </div>
        <div class="card">
            <p class="stat-label" style="margin-bottom: 0.5rem;">.NET API Layer</p>
            <span class="badge @(_health.DbConnected ? "badge-emerald" : "badge-rose")">@(_health.DbConnected ? "Online" : "Degraded")</span>
        </div>
        <div class="card">
            <p class="stat-label" style="margin-bottom: 0.5rem;">Data Ingestion</p>
            <span class="badge badge-emerald">Healthy · @_health.TotalTelemetryLogs logs processed</span>
        </div>
        <div class="card">
            <p class="stat-label" style="margin-bottom: 0.5rem;">Anomaly Engine</p>
            <span class="badge @(_health.CriticalAnomaliesLast24h > 0 ? "badge-amber" : "badge-emerald")">Running · @_health.CriticalAnomaliesLast24h alerts/24h</span>
        </div>
    </div>
}

<div class="card">
    <h3 style="margin-bottom: 1rem;">Incident History</h3>
    @if (_incidents is null || _incidents.Count == 0)
    {
        <p class="empty-state">No critical incidents recorded.</p>
    }
    else
    {
        @foreach (var incident in _incidents)
        {
            <div class="alert-banner" style="justify-content: space-between;">
                <span class="mono">@incident.SensorId</span>
                <span>score @incident.Score.ToString("0.00")</span>
                <span style="color: var(--text-faint);">@incident.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")</span>
            </div>
        }
    }
</div>

@code {
    private SystemHealthDto? _health;
    private List<AnomalyLogDto>? _incidents;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _health = await Api.GetHealthSummaryAsync();
            _incidents = await Api.GetIncidentsAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Couldn't load system health data.";
            Console.Error.WriteLine(ex);
        }
    }
}