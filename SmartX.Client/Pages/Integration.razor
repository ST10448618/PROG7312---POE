@page "/integrations"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SensorApiClient Api

<div class="page-header">
    <h1>Integration</h1>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

<div class="integration-grid">
    @if (_integrations is not null)
    {
        @foreach (var i in _integrations)
        {
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <span style="font-weight: 500;">@i.Name</span>
                    <span class="badge @StatusBadge(i.Status)">
                        @if (i.Status == "Connected")
                        {
                            <span class="pulse-dot"><span class="ping pulse-slow"></span><span class="core"></span></span>
                        }
                        @i.Status
                    </span>
                </div>
                <p class="mono" style="font-size: 0.75rem; color: var(--text-faint); margin-bottom: 0.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@i.WebhookUrl</p>
                <p style="font-size: 0.75rem; color: var(--text-faint); margin-bottom: 1rem;">
                    Last sync: @(i.LastSyncAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "never")
                </p>
                <div style="display: flex; gap: 0.5rem;">
                    <button class="btn-secondary btn-sm" style="flex: 1;" @onclick="() => Test(i.Id)">Test connection</button>
                    <button class="btn-secondary btn-sm" style="flex: 1;" @onclick="() => Disconnect(i.Id)">Disconnect</button>
                </div>
            </div>
        }
    }

    <button class="integration-add" @onclick="() => _showModal = true">+ Add New Integration</button>
</div>

@if (_showModal)
{
    <div class="modal-backdrop">
        <div class="card modal-box">
            <h3 style="margin-bottom: 1rem;">New Integration</h3>
            <div class="form-field">
                <label>Name</label>
                <input @bind="_newName" placeholder="e.g. Slack Alerts" />
            </div>
            <div class="form-field">
                <label>Webhook URL</label>
                <input @bind="_newUrl" placeholder="https://…" />
            </div>
            <div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem;">
                <button class="btn-secondary" @onclick="() => _showModal = false">Cancel</button>
                <button class="btn-primary" @onclick="Register">Add</button>
            </div>
        </div>
    </div>
}

@code {
    private List<IntegrationDto>? _integrations;
    private bool _showModal;
    private string _newName = "";
    private string _newUrl = "";
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { _integrations = await Api.GetIntegrationsAsync(); }
        catch (Exception ex) { _loadError = "Couldn't load integrations."; Console.Error.WriteLine(ex); }
    }

    private async Task Register()
    {
        await Api.RegisterIntegrationAsync(_newName, _newUrl);
        _showModal = false;
        _newName = ""; _newUrl = "";
        await Load();
    }

    private async Task Test(int id) { await Api.TestIntegrationAsync(id); await Load(); }
    private async Task Disconnect(int id) { await Api.DisconnectIntegrationAsync(id); await Load(); }

    private static string StatusBadge(string status) => status switch
    {
        "Connected" => "badge-emerald",
        "Pending" => "badge-amber",
        _ => "badge-rose"
    };
}